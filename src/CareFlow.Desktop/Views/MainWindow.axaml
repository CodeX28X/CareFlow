<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.Desktop.ViewModels"
        xmlns:views="using:CareFlow.Desktop.Views"
        x:Class="CareFlow.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CareFlow - Diagnostic Booking Management"
        Width="1100" Height="720" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F4F7FA">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:AvailabilityViewModel"><views:AvailabilityView /></DataTemplate>
        <DataTemplate DataType="vm:NewBookingViewModel"><views:NewBookingView /></DataTemplate>
        <DataTemplate DataType="vm:BookingHistoryViewModel"><views:BookingHistoryView /></DataTemplate>
    </Window.DataTemplates>

	<Window.Styles>

		<!-- Normal sidebar button -->
		<Style Selector="Button.sidebarNav">
			<Setter Property="Background" Value="#29465C"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#29465C"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<!-- Hover state -->
		<Style Selector="Button.sidebarNav:pointerover">
			<Setter Property="Background" Value="#365D78"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#365D78"/>
		</Style>

		<!-- Pressed state -->
		<Style Selector="Button.sidebarNav:pressed">
			<Setter Property="Background" Value="#19364C"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#19364C"/>
		</Style>

	</Window.Styles>

	<Grid ColumnDefinitions="230,*">
        <Border Grid.Column="0" Background="#172C40" Padding="20">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,12,0,38">
                    <TextBlock Text="CareFlow" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="DIAGNOSTIC CENTER" Foreground="#ACC3D2" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="WORKSPACE" Foreground="#ACC3D2" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="11"/>
                <StackPanel Grid.Row="2" Spacing="10">

					<Button Classes="sidebarNav"
							Content="Service Availability"
							Command="{Binding ShowAvailabilityCommand}"
							HorizontalContentAlignment="Left"
							Padding="14,12"/>

					<Button Classes="sidebarNav"
							Content="New Booking"
							Command="{Binding ShowNewBookingCommand}"
							HorizontalContentAlignment="Left"
							Padding="14,12"/>

					<Button Classes="sidebarNav"
							Content="Booking History"
							Command="{Binding ShowHistoryCommand}"
							HorizontalContentAlignment="Left"
							Padding="14,12"/>

					<TextBlock Text="Selected page" Margin="0,20,0,0" Foreground="#ACC3D2" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentNavigation}" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="CareFlow Desktop" Foreground="#ACC3D2"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="24" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="25" FontWeight="Bold" Foreground="#172C40" />
                    <TextBlock Text="{Binding CurrentPageDescription}" Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>
