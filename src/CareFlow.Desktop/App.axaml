<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CareFlow.Desktop.App"
             xmlns:local="using:CareFlow.Desktop"
             RequestedThemeVariant="Light">
             <!-- CareFlow uses fixed light surface colors. Pin Fluent controls to Light so popups, checkboxes, and list selection remain readable regardless of Windows dark mode. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>